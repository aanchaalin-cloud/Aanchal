# ──────────────────────────────────────────
# Supabase (Database, Auth, Storage)
# ──────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ──────────────────────────────────────────
# Razorpay (Payments)
# ──────────────────────────────────────────
# Get these from: https://dashboard.razorpay.com → Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ──────────────────────────────────────────
# Email Service (Resend / SendGrid / Postmark)
# ──────────────────────────────────────────
# Sign up at https://resend.com → API Keys
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
EMAIL_FROM=orders@aanchal.in
ADMIN_EMAIL=admin@aanchal.in

# ──────────────────────────────────────────
# App
# ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Aanchal

# ──────────────────────────────────────────
# Redis / Rate Limiting (Upstash)
# ──────────────────────────────────────────
# Optional: https://upstash.com → Redis Database
UPSTASH_REDIS_REST_URL=https://YOUR_REGION.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# ──────────────────────────────────────────
# Analytics & Monitoring
# ──────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.us.sentry.io/xxxxx

# ──────────────────────────────────────────
# Shipping (Shiprocket / NimbusPost)
# ──────────────────────────────────────────
SHIPROCKET_EMAIL=YOUR_SHIPROCKET_EMAIL
SHIPROCKET_PASSWORD=YOUR_SHIPROCKET_PASSWORD

# ──────────────────────────────────────────
# Search (Algolia / Meilisearch)
# ──────────────────────────────────────────
NEXT_PUBLIC_ALGOLIA_APP_ID=YOUR_ALGOLIA_APP_ID
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=YOUR_ALGOLIA_SEARCH_KEY
ALGOLIA_ADMIN_KEY=YOUR_ALGOLIA_ADMIN_KEY
