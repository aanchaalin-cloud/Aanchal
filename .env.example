# ──────────────────────────────────────────
# Supabase (Database, Auth, Storage)
# ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ──────────────────────────────────────────
# Razorpay (Payments)
# ──────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ──────────────────────────────────────────
# App
# ──────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Aanchal
NEXT_PUBLIC_WHATSAPP_NUMBER=+918949911242

# ──────────────────────────────────────────
# Shipping Provider (optional)
# ──────────────────────────────────────────
# Set to one of: nimbuspost, shipyaari, pickrr, delhivery, xpressbees
# Leave blank to disable shipping API integration.
# SHIPPING_PROVIDER=nimbuspost
# SHIPMENT_API_KEY=YOUR_SHIPMENT_API_KEY
# SHIPMENT_API_SECRET=YOUR_SHIPMENT_API_SECRET

# ──────────────────────────────────────────
# WhatsApp / Notification Provider (optional)
# ──────────────────────────────────────────
# Set to one of: meta, gupshup, twilio
# Leave blank to disable WhatsApp notifications.
# NOTIFICATION_PROVIDER=meta
# WHATSAPP_API_TOKEN=YOUR_WHATSAPP_API_TOKEN
# WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
# WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_BUSINESS_ACCOUNT_ID
