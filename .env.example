# ──────────────────────────────────────────
# Supabase (Database, Auth, Storage)
# ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ──────────────────────────────────────────
# Order Status Token Signing
# ──────────────────────────────────────────
# Signs the checkout order-status/cancel tokens that appear in URLs and
# order-confirmation emails. Use a long random string (e.g. `openssl rand -hex 32`).
# If unset, the service role key is used so existing tokens stay valid.
ORDER_STATUS_TOKEN_SECRET=YOUR_LONG_RANDOM_SECRET

# ──────────────────────────────────────────
# Paytm (Payments) — primary gateway
# ──────────────────────────────────────────
# When PAYTM_MID + PAYTM_MERCHANT_KEY are set, checkout uses Paytm.
# PAYTM_ENV: "production" or "test" (staging). Leave unset for the Paytm staging gateway.
PAYTM_MID=YOUR_MERCHANT_ID
PAYTM_MERCHANT_KEY=YOUR_MERCHANT_KEY
PAYTM_WEBSITE_NAME=WEBSTAGING
# PAYTM_ENV=production
# PAYTM_GATEWAY_BASE_URL=https://securegw.paytm.in
# NEXT_PUBLIC_APP_URL is used to build the Paytm callback URL.

# ──────────────────────────────────────────
# Razorpay (Payments) — fallback gateway
# ──────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ──────────────────────────────────────────
# App
# ──────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Aanchal
NEXT_PUBLIC_WHATSAPP_NUMBER=+918949911242

# ──────────────────────────────────────────
# Shipping Provider (Shiprocket)
# ──────────────────────────────────────────
# Set SHIPPING_PROVIDER=shiprocket and add credentials to enable courier
# creation from the admin order page. Leave blank to disable.
# SHIPPING_PROVIDER=shiprocket
# SHIPROCKET_EMAIL=YOUR_SHIPROCKET_LOGIN_EMAIL
# SHIPROCKET_PASSWORD=YOUR_SHIPROCKET_LOGIN_PASSWORD
# SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in
